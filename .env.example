# Apaleo OAuth 2.0 client credentials (simple client, developer dashboard)
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=
APALEO_PROPERTY_ID=PAR
APALEO_IDENTITY_URL=https://identity.apaleo.com
APALEO_API_URL=https://api.apaleo.com

# Phase 2 only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000

# UI integration: shared password for the write actions. Writes are refused when empty.
OPS_WRITE_PASSWORD=
# Account allowed to use the embedded page. Derived from the API when left empty.
OPS_ACCOUNT_CODE=
# Properties the UI may never write to, comma-separated.
OPS_DENY_PROPERTIES=PAR
