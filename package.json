{
  "name": "apaleo-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mini booking engine + room allocation agent on the Apaleo API",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check-connection.js",
    "agent": "node scripts/run-agent.js",
    "agent:apply": "node scripts/run-agent.js --apply",
    "tag-units": "node scripts/tag-units.js",
    "seed": "node scripts/seed-reservations.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  }
}
